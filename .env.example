# --- Beehiiv ---
# Get from https://app.beehiiv.com/settings/integrations/api (API v2)
BEEHIIV_API_KEY=

# Publication ID, looks like "pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
BEEHIIV_PUBLICATION_ID=

# Automation ID from the automation's URL, looks like "aut_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
BEEHIIV_AUTOMATION_ID=

# Optional: set a UTM source so you can track WebinarJam sign-ups in Beehiiv
BEEHIIV_UTM_SOURCE=webinarjam

# Optional: send Beehiiv's built-in welcome email (true/false)
BEEHIIV_SEND_WELCOME_EMAIL=false

# Optional: reactivate existing unsubscribed contacts (true/false)
BEEHIIV_REACTIVATE_EXISTING=true

# --- Webhook security ---
# Shared secret: WebinarJam must send this in the `x-webhook-secret` header or `?secret=` query string.
# Leave empty to disable verification (NOT recommended in production).
WEBHOOK_SECRET=

# --- Server ---
PORT=3000
